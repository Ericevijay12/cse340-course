<%- include('partials/header') %>
<main class="page-container">
  <h1><%= title %></h1>
  <p>Explore our upcoming community service projects:</p>

  <ul class="bullet-list">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach(project => { %>
        <li>
          <strong><%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>:</strong>
          <a href="/project/<%= project.project_id %>"><%= project.title %></a>
          (<em><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></em>)
        </li>
      <% }) %>
    <% } else { %>
      <li>No upcoming service projects scheduled.</li>
    <% } %>
  </ul>
</main>
<%- include('partials/footer') %>
