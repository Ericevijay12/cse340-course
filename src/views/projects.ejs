<%- include('partials/header') %>
<main class="page-container">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h1><%= title %></h1>
    <a href="/new-project" class="btn-primary">+ Add Project</a>
  </div>
  <p>Explore our upcoming community service projects:</p>

  <ul class="bullet-list" style="line-height: 1.8;">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach(project => { %>
        <li>
          <strong><%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>:</strong>
          <a href="/project/<%= project.project_id %>" style="color: #0d47a1; font-weight: 600;"><%= project.title %></a>
          (<em><a href="/organization/<%= project.organization_id %>" style="color: #1976d2;"><%= project.organization_name %></a></em>)
        </li>
      <% }) %>
    <% } else { %>
      <li>No upcoming service projects scheduled.</li>
    <% } %>
  </ul>
</main>
<%- include('partials/footer') %>
