<%- include('partials/header') %>
<main class="page-container">
  <h1><%= title %></h1>
  <p>Explore our upcoming community service projects:</p>

  <ul class="bullet-list">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach(project => { %>
        <li>
          <strong><%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>:</strong>
          <%= project.title %> <em>(<%= project.organization_name %>)</em>
        </li>
      <% }) %>
    <% } else { %>
      <li>No service projects currently scheduled.</li>
    <% } %>
  </ul>
</main>
<%- include('partials/footer') %>
