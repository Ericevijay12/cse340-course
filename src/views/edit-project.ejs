<%- include('partials/header') %>
<main class="page-container">
  <div class="form-card">
    <h1><%= title %></h1>
    <form action="/edit-project/<%= project.project_id %>" method="POST">
      <div class="form-group">
        <label for="title">Project Title</label>
        <input type="text" id="title" name="title" value="<%= project.title %>" required maxlength="150">
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" required maxlength="500"><%= project.description %></textarea>
      </div>
      <div class="form-group">
        <label for="location">Location</label>
        <input type="text" id="location" name="location" value="<%= project.location %>" required maxlength="255">
      </div>
      <div class="form-group">
        <label for="date">Date</label>
        <input type="date" id="date" name="date" value="<%= new Date(project.project_date).toISOString().split('T')[0] %>" required>
      </div>
      <div class="form-group">
        <label for="organizationId">Partner Organization</label>
        <select id="organizationId" name="organizationId" required>
          <% organizations.forEach(org => { %>
            <option value="<%= org.organization_id %>" <%= org.organization_id === project.organization_id ? 'selected' : '' %>><%= org.name %></option>
          <% }); %>
        </select>
      </div>
      <button type="submit" class="btn-primary">Update Project</button>
    </form>
  </div>
</main>
<%- include('partials/footer') %>
