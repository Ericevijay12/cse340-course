<%- include('partials/header') %>
<main class="page-container">
  <h1><%= title %></h1>

  <h2><%= organizationDetails.name %></h2>
  <img src="<%= organizationDetails.logo_path %>" alt="<%= organizationDetails.name %> logo" style="max-width: 150px;">

  <p><strong>Contact Email:</strong> <a href="mailto:<%= organizationDetails.email %>"><%= organizationDetails.email %></a></p>

  <h3>Service Projects</h3>
  <ul class="bullet-list">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach(project => { %>
        <li>
          <a href="/project/<%= project.project_id %>"><%= project.title %></a>
          (<%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>)
        </li>
      <% }) %>
    <% } else { %>
      <li>No service projects currently associated with this organization.</li>
    <% } %>
  </ul>
</main>
<%- include('partials/footer') %>
