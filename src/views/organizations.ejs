<%- include('partials/header') %>
<main class="page-container">
  <h1><%= title %></h1>
  <p>Here are a few of our trusted partner organizations:</p>
  
  <div class="card-grid">
    <% if (organizations && organizations.length > 0) { %>
      <% organizations.forEach(org => { %>
        <div class="card-item">
          <img src="<%= org.logo_path || '/images/default-logo.png' %>" alt="<%= org.name %> Logo">
          <div class="card-info">
            <strong><%= org.name %></strong>
            <span><%= org.email %></span>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p>No organizations found.</p>
    <% } %>
  </div>
</main>
<%- include('partials/footer') %>
