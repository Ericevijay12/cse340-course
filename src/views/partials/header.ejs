<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'CSE 340 Service Network' %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <header class="site-header">
        <div class="header-container">
            <a href="/" class="site-logo">CSE 340 Network</a>
            <nav class="main-nav">
                <a href="/">Home</a>
                <a href="/organizations">Organizations</a>
                <a href="/projects">Projects</a>
                <a href="/categories">Categories</a>
            </nav>
        </div>
    </header>

    <div class="flash-container page-container" style="margin-top: 1rem;">
        <% if (typeof flash === 'function') { %>
            <% const messages = flash(); %>
            <% Object.keys(messages).forEach(type => { %>
                <% if (messages[type] && messages[type].length > 0) { %>
                    <% messages[type].forEach(msg => { %>
                        <div class="alert alert-<%= type %>">
                            <%= msg %>
                        </div>
                    <% }); %>
                <% } %>
            <% }); %>
        <% } %>
    </div>
